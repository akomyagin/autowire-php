{
    "name": "akomyagin/autowire-php",
    "description": "Framework-agnostic PHP DI container with reflection-based constructor autowiring, lifecycle control and interface-aware circular dependency detection.",
    "type": "library",
    "license": "MIT",
    "keywords": ["dependency-injection", "di-container", "autowiring", "reflection", "psr-11"],
    "authors": [
        {
            "name": "Alexander Komyagin",
            "email": "alkom68@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "psr/cache": "^3.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AutowirePHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AutowirePHP\\Tests\\": "tests/",
            "AutowirePHP\\Benchmarks\\": "benchmarks/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php-cs-fixer check --diff",
        "lint:fix": "php-cs-fixer fix",
        "bench": "php benchmarks/bench.php"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
